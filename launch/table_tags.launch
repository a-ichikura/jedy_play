<launch>
  <!-- place-0 を world の基準とする -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_0_tf" args="0 0 0 0 0 0 world place-0" />

  <!-- 他の place-n は place-0 相対に定義 -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_1_tf" args="0.0 0.28 0 0 0 0 place-0 place-1" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_2_tf" args="0.0 0.57 0 0 0 0 place-0 place-2" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_3_tf" args="0.0 0.85 0 0 0 0 place-0 place-3" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_4_tf" args="0.0 1.14 0 0 0 0 place-0 place-4" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="place_5_tf" args="0.25 0.00 0 0 0 0 place-0 place-5" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_6_tf" args="0.25 0.28 0 0 0 0 place-0 place-6" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_7_tf" args="0.25 0.57 0 0 0 0 place-0 place-7" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_8_tf" args="0.25 0.85 0 0 0 0 place-0 place-8" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_9_tf" args="0.25 1.14 0 0 0 0 place-0 place-9" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="place_10_tf" args="0.50 0.00 0 0 0 0 place-0 place-10" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_11_tf" args="0.50 0.28 0 0 0 0 place-0 place-11" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_12_tf" args="0.50 0.57 0 0 0 0 place-0 place-12" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_13_tf" args="0.50 0.85 0 0 0 0 place-0 place-13" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="place_14_tf" args="0.50 1.14 0 0 0 0 place-0 place-14" />
</launch>
