<launch>
  <arg name="urdf_path" default="$(find kxr_humanoid_movebase_ichikura_version2)/urdf/jedy.urdf" />
  <arg name="servo_config_path" default="$(find kxr_humanoid_movebase_ichikura_version2)/config/jedy_servo_config.yaml" />
  <arg name="use_camera" default="false" />
  <arg name="use_fullbody_controller" default="false"/>

  <!-- jedy_controllers.yaml を最初にロード -->
  <rosparam file="$(find jedy_play)/config/jedy_controllers.yaml" />

  <!-- default_controller を手動で設定（minimal.launch の影響を回避） -->
  <rosparam param="default_controller">
    - head_controller
    - rarm_controller
    - larm_controller
  </rosparam>


  <include file="$(find jedy_bringup)/launch/jedy_bringup.launch" >
    <arg name="urdf_path" value="$(arg urdf_path)" />
    <arg name="servo_config_path" value="$(arg servo_config_path)" />
    <arg name="use_fullbody_controller" value="$(arg use_fullbody_controller)" />
  </include>

  <rosparam file="$(find jedy_play)/config/jedy_controllers.yaml" />
<!--  <node name="arm_controllers_spawner" -->
<!--      pkg="controller_manager" type="spawner" -->
<!--      output="screen" -->
<!--      args="joint_state_controller head_controller larm_controller rarm_controller"/> -->

  <!-- <include file="$(find kxr_controller)/launch/joy.launch" /> -->
  <node pkg="rosserial_python" name="serial_node" type="serial_node.py">
	<param name="~port" value="/dev/ttyACM-m5"/>
	<param name="~baud" value="115200"/>
  </node>

<group if="$(arg use_camera)">
 <include file="$(find jedy_bringup)/launch/d405.launch">
 <arg name="color_width" value="640"/>
 <arg name="color_height" value="480"/>	
 <arg name="color_fps" value="30"/>		
 <arg name="enable_pointcloud" value="true"/>
</include>
</group>

<include file="$(find respeaker_ros)/launch/sample_respeaker.launch" />

<node pkg="jedy_play" type="tone_player_alsa.py" name="tone_player_alsa" output="screen">
  <param name="~alsa_device" value="pulse"/>
  <param name="~channels" value="2"/>

  <!-- chimeを土台に“コロコロ”化 -->
  <param name="~preset" value="blip"/>
  <param name="~adsr_decay_ms" value="100"/>    <!-- 余韻を早めに落とす -->
  <param name="~adsr_release_ms" value="60"/>   <!-- 余韻を短く（クリックが出たら80〜120に戻す） -->
  <param name="~vibrato_hz" value="8"/>         <!-- 速めのビブラート -->
  <param name="~vibrato_cents" value="28"/>     <!-- ±25〜35centsくらいが“おしゃべり感” -->
  <param name="~tremolo_hz" value="6"/>         <!-- 音量のゆらぎ -->
  <param name="~tremolo_depth" value="0.18"/>   <!-- 0.12〜0.25で微調整 -->
  <param name="~harmonics" value="1:1.0,2:0.25,3:0.12"/> <!-- 三角に少し倍音でキラッと -->
  <param name="~gap_ms" value="8"/>             <!-- ノート間に短い無音→“プチッ”と切れてコロコロ感UP -->
  <param name="~gain" value="0.65"/>            <!-- 全体ゲイン。歪むなら0.55〜0.6へ -->
</node>


</launch>
